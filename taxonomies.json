---
layout: null
---
{% assign all_categories = site.posts | map: "categories" | compact | uniq %}
{% assign all_tags_raw = "" | split: "" %}
{% for post in site.posts %}{% assign all_tags_raw = all_tags_raw | concat: post.tags %}{% endfor %}
{% assign all_tags = all_tags_raw | uniq | sort %}

[
  {% for cat in all_categories %}
    {
      "name": "{{ cat | escape }}",
      "type": "Categoria",
      "url": "/categorias/{{ cat | slugify }}/"
    }
    {% unless forloop.last and all_tags.size == 0 %},{% endunless %}
  {% endfor %}
  
  {% for tag in all_tags %}
    {% if tag != "" %}
    {
      "name": "{{ tag | escape }}",
      "type": "Tag",
      "url": "/tags/{{ tag | slugify }}/"
    }
    {% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
  
  {% comment %} 
    A ADIÇÃO MANUAL ESTÁ AQUI.
    Garante que "premiados" apareça na busca.
  {% endcomment %}
  {% if all_tags.size > 0 or all_categories.size > 0 %},{% endif %}
  {
    "name": "Premiados",
    "type": "Arquivo",
    "url": "/premiados/"
  }
]