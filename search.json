---
layout: null
---
[
  {% for projeto in site.posts %}
    {
      "title": "{{ projeto.title | escape }}",
      "aluno": "{{ projeto.aluno | escape }}",
      "url": "{{ projeto.url | relative_url }}",
      "categories": "{{ projeto.categories | first | escape }}",
      "premio": "{{ projeto.premio | escape }}"
    }
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
]