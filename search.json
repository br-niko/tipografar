---
layout: null
---
[
  {% for projeto in site.projetos %}
    {
      "title": "{{ projeto.title | escape }}",
      "aluno": "{{ projeto.aluno | escape }}",
      "url": "{{ projeto.url | relative_url }}",
      "tags": "{{ projeto.tags | join: ', ' }}",
      "content": {{ projeto.content | strip_html | strip_newlines | jsonify }}
    }
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
