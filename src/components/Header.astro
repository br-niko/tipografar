---
---

<header class="site-header py-3 mb-4" style="border-top: 1px solid #FFFFFF;">
  <div class="container d-flex flex-wrap align-items-center justify-content-center justify-content-lg-between">
    <a href="/" class="logo-link d-flex align-items-center mb-3 mb-md-0 me-md-auto text-dark text-decoration-none">
      <span class="logo-projeto">Projeto</span>
      <span class="logo-tipografar">Tipografar</span>
    </a>
    <div class="d-flex align-items-center">
      <div class="search-wrapper position-relative me-lg-4">
        <form class="search-form" role="search" id="search-form" action="/busca" method="get">
          <div class="input-group">
            <input
              type="search"
              id="search-input"
              name="q"
              class="form-control"
              placeholder="Buscar por projeto, aluno, tag..."
              aria-label="Buscar"
              autocomplete="off"
            />
            <button class="btn search-btn-group" type="submit" aria-label="Buscar">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M16.1383 17.1923L9.8575 10.9113C9.3575 11.3241 8.7825 11.6472 8.1325 11.8805C7.4825 12.1138 6.81008 12.2305 6.11525 12.2305C4.40608 12.2305 2.95958 11.6388 1.77575 10.4553C0.591917 9.27175 0 7.82558 0 6.11675C0 4.40808 0.59175 2.96142 1.77525 1.77675C2.95875 0.59225 4.40492 0 6.11375 0C7.82242 0 9.26908 0.591916 10.4537 1.77575C11.6382 2.95958 12.2305 4.40608 12.2305 6.11525C12.2305 6.82942 12.1107 7.5115 11.871 8.1615C11.6312 8.8115 11.3113 9.37683 10.9113 9.8575L17.192 16.1383L16.1383 17.1923ZM6.11525 10.7308C7.40375 10.7308 8.49508 10.2836 9.38925 9.38925C10.2836 8.49508 10.7308 7.40375 10.7308 6.11525C10.7308 4.82675 10.2836 3.73542 9.38925 2.84125C8.49508 1.94692 7.40375 1.49975 6.11525 1.49975C4.82675 1.49975 3.73542 1.94692 2.84125 2.84125C1.94692 3.73542 1.49975 4.82675 1.49975 6.11525C1.49975 7.40375 1.94692 8.49508 2.84125 9.38925C3.73542 10.2836 4.82675 10.7308 6.11525 10.7308Z"/>
              </svg>
            </button>
          </div>
        </form>
        <div
          id="search-results"
          class="position-absolute"
          style="top: 100%; left: 0; right: 0; z-index: 1000; display: none;"
        ></div>
      </div>

      <ul class="nav nav-pills">
        <li class="nav-item"><a href="#navegacao-tags" class="nav-link">categorias</a></li>
        <li class="nav-item"><a href="/arquivo" class="nav-link">arquivo</a></li>
        <li class="nav-item"><a href="/sobre" class="nav-link">sobre</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  interface SearchProject {
    title: string;
    aluno: string;
    url: string;
    category: string;
    categoryUrl: string;
    semestre: string;
    premio: string;
    tags: string[];
    imagemCapa: string;
    searchText: string;
  }

  interface SearchTaxonomy {
    name: string;
    type: string;
    url: string;
    count: number;
    searchText: string;
  }

  interface SearchPayload {
    projects: SearchProject[];
    taxonomies: SearchTaxonomy[];
  }

  function normalizeText(str: string): string {
    return (str || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  let cachedIndex: SearchPayload | null = null;

  async function loadIndex(): Promise<SearchPayload> {
    if (cachedIndex) return cachedIndex;
    const res = await fetch('/search-index.json');
    cachedIndex = await res.json();
    return cachedIndex!;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results');

    if (!searchInput || !resultsContainer) return;

    // Pré-carrega o índice em background
    loadIndex().catch((err) => console.error('Erro ao carregar índice de busca:', err));

    searchInput.addEventListener('input', async () => {
      const rawQuery = searchInput.value.trim();
      const query = normalizeText(rawQuery);

      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        resultsContainer.style.display = 'none';
        return;
      }

      const data = await loadIndex();
      const terms = query.split(/\s+/);

      const matchedProjects = data.projects.filter((p) =>
        terms.every((t) => p.searchText.includes(t))
      );

      const matchedTaxonomies = data.taxonomies.filter((tax) =>
        terms.every((t) => tax.searchText.includes(t))
      );

      let html = '';
      const sliceLimit = 4;

      if (matchedProjects.length > 0) {
        html += '<div class="search-result-header">Projetos</div>';
        html += '<ul class="list-group list-group-flush">';
        matchedProjects.slice(0, sliceLimit).forEach((doc) => {
          html += `<li class="list-group-item">
            <a href="${doc.url}">${doc.title}</a><br/>
            <small>${doc.aluno} • ${doc.semestre}</small>
          </li>`;
        });
        html += '</ul>';
      }

      if (matchedTaxonomies.length > 0) {
        html += '<div class="search-result-header">Categorias, Tags e Semestres</div>';
        html += '<ul class="list-group list-group-flush">';
        matchedTaxonomies.slice(0, sliceLimit).forEach((tax) => {
          html += `<li class="list-group-item">
            <a href="${tax.url}">${tax.name} <span class="search-result-type">(${tax.type} • ${tax.count})</span></a>
          </li>`;
        });
        html += '</ul>';
      }

      const total = matchedProjects.length + matchedTaxonomies.length;
      if (total > 0) {
        html += `<a href="/busca?q=${encodeURIComponent(rawQuery)}" class="search-see-all">Ver todos os ${total} resultados →</a>`;
      } else {
        html = '<ul class="list-group list-group-flush"><li class="list-group-item">Nenhum resultado encontrado.</li></ul>';
      }

      resultsContainer.innerHTML = html;
      resultsContainer.style.display = 'block';
    });

    // Fecha o autocomplete ao clicar fora
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !resultsContainer.contains(e.target as Node)) {
        resultsContainer.style.display = 'none';
      }
    });
  });
</script>
