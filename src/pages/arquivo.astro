---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getAllProjects, getTaxonomies } from '../lib/projects';

const allProjects = await getAllProjects();
const { semesters } = await getTaxonomies();

const grouped = semesters.map((sem) => ({
  semester: sem.name,
  slug: sem.slug,
  items: allProjects.filter((p) => p.data.semestre.trim() === sem.name),
}));
---

<BaseLayout title="Arquivo de Projetos">
  <div class="archive-page">
    <h1 class="page-title">arquivo de projetos</h1>
    <hr class="section-divider" />
    <p>Todos os projetos da disciplina, organizados por semestre.</p>

    {grouped.map((group) => (
      <section class="mb-5">
        <div class="d-flex justify-content-between align-items-baseline mt-5 mb-2">
          <h2 class="section-title mb-0">{group.semester}</h2>
          <a href={`/semestres/${group.slug}`} class="link-primary">
            ver semestre ({group.items.length}) →
          </a>
        </div>
        <hr class="section-divider--muted" />
        <div class="row">
          {group.items.map((projeto) => <ProjectCard projeto={projeto} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
