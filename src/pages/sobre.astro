---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="sobre o projeto tipografar">
  <div class="about-page">
    <header class="project-header mb-4">
      <h1 class="page-title">sobre o projeto tipografar</h1>
      <hr class="section-divider" />
    </header>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div
          class="card-img-placeholder mb-4"
          style="height: 300px; background-image: url('/assets/images/placeholder.svg');"
        ></div>

        <div class="page-content">
          <h2>O Projeto Tipografar</h2>
          <p>
            Portfólio de projetos de estudantes de design tipográfico e lettering
            desenvolvidos na disciplina <strong>Projeto Tipografar</strong> nos cursos
            superiores em Design e Design Gráfico do <strong>Centro Universitário Senac - SP</strong>.
          </p>
          <p>
            A plataforma reúne investigações históricas, experimentações de processo,
            caligrafia, lettering e desenho de tipos digitais produzidos semestralmente,
            valorizando tanto o resultado visual quanto o registro metodológico e conceitual
            de cada estudante.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
